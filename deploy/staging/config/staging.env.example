# Somente placeholders. Cadastre valores reais no secret manager.
NODE_ENV=production
APP_ENV=staging
PORT=3000
DATABASE_PATH=/var/lib/consultoria/consultoria.sqlite
SQLITE_BACKUP_DIR=/var/backups/consultoria
SQLITE_BACKUP_RETENTION=10
SQLITE_VOLUME_ACK=single-instance-persistent-volume
API_REPLICA_COUNT=1
ENABLE_DEMO_SEED=false
JWT_SECRET=<secret-manager>
JWT_EXPIRES_IN=7d
APP_PUBLIC_URL=https://app-staging.exemplo.com
API_PUBLIC_URL=https://api-staging.exemplo.com
CORS_ORIGINS=https://app-staging.exemplo.com
TRUST_PROXY_HOPS=1
EMAIL_PROVIDER=http
EMAIL_ALLOW_TEST_PROVIDER=false
EMAIL_FROM=no-reply@staging.exemplo.com
EMAIL_API_URL=https://provedor-de-email.exemplo.com/send
EMAIL_API_KEY=<secret-manager>
OPENAI_API_KEY=<secret-manager-or-empty-by-policy>
REQUIRE_AI_IN_READINESS=false
ENABLE_INTERNAL_METRICS=true
REQUIRE_LEGAL_ACCEPTANCE=true
TERMS_VERSION=<approved-version>
PRIVACY_VERSION=<approved-version>
ENABLE_EXTERNAL_ALERTS=false
ALERT_WEBHOOK_URL=<secret-manager-when-enabled>
ALERT_WEBHOOK_TIMEOUT_MS=3000
BACKUP_EXTERNAL_PROVIDER=filesystem
BACKUP_EXTERNAL_DIRECTORY=/mnt/backup-externo
LOG_FORMAT=json
