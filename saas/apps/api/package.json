{
  "name": "@consultoria/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:sqlite-to-postgres": "tsx src/database/migrate-sqlite-to-postgres.ts",
    "db:validate": "tsx src/database/validate.ts",
    "admin:bootstrap": "tsx src/database/admin-bootstrap.ts",
    "db:backup:sqlite": "tsx src/database/backup-sqlite.ts",
    "db:backup:external": "tsx src/database/backup-external-sqlite.ts",
    "db:backup:postgres": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-postgres.ps1",
    "db:restore:postgres": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-postgres.ps1",
    "db:restore:sqlite": "tsx src/database/restore-sqlite.ts",
    "staging:seed": "tsx src/database/staging-seed.ts",
    "staging:cleanup": "tsx src/database/staging-cleanup.ts",
    "demo:seed": "tsx src/database/demo-seed.ts",
    "demo:cleanup": "tsx src/database/demo-cleanup.ts",
    "test:unit": "tsx src/tests/security.unit.ts && tsx src/tests/database-adapter.unit.ts",
    "test:operations": "tsx src/tests/sqlite-operations.test.ts && tsx src/tests/external-operations.test.ts && tsx src/tests/staging-preparation.test.ts && tsx src/tests/staging-data.test.ts && tsx src/tests/demo-data.test.ts",
    "test:e2e": "tsx src/tests/multitenant.e2e.ts && tsx src/tests/security.e2e.ts && tsx src/tests/operations.e2e.ts && tsx src/tests/readiness-incomplete.e2e.ts",
    "test:e2e:sqlite": "npm run test:e2e",
    "test:e2e:postgres": "tsx src/tests/postgres-runtime.e2e.ts",
    "test:postgres:unavailable": "tsx src/tests/postgres-readiness-unavailable.e2e.ts",
    "test:runtime:isolation": "tsx src/tests/runtime-provider-isolation.e2e.ts",
    "test:admin:bootstrap": "tsx src/tests/admin-bootstrap.e2e.ts",
    "test:legal:postgres": "tsx src/tests/postgres-legal-acceptance.e2e.ts",
    "test:migrator:postgres": "tsx src/tests/sqlite-to-postgres-migration.e2e.ts",
    "test:smoke": "npm run test:e2e",
    "test:smoke:sqlite": "npm run test:smoke",
    "test:smoke:postgres": "tsx src/tests/postgres-runtime.e2e.ts --smoke",
    "test:smoke:staging": "tsx src/tests/staging-smoke.ts",
    "test:load:lite": "tsx src/tests/light-load.local.ts",
    "test:staging:start": "tsx src/tests/staging-startup.e2e.ts",
    "test": "npm run test:unit && npm run test:operations && npm run test:e2e"
  },
  "dependencies": {
    "@consultoria/domain": "*",
    "@types/pdfkit": "^0.17.6",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.34.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.22.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "typescript": "^5.8.2"
  }
}
