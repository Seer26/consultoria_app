NODE_ENV=development
APP_ENV=local
PORT=3000

# Local default. SQLite remains supported for development and E2E while the runtime
# repositories are migrated to async Postgres access.
# No perfil local operacional, use caminho absoluto e nunca um banco demo/E2E.
DATABASE_PATH=C:/Users/Pichau/consultoria_app/saas/apps/api/data/consultoria.sqlite
SQLITE_BACKUP_DIR=./backups/sqlite
SQLITE_BACKUP_RETENTION=10
API_REPLICA_COUNT=1
# Staging only: acknowledge the database path is a persistent, single-instance volume.
SQLITE_VOLUME_ACK=

# Postgres for production/staging infrastructure, migrations and healthcheck.
# Example: postgres://user:password@localhost:5432/consultoria
DATABASE_URL=
# Local Compose placeholders only. Do not reuse in staging/production.
POSTGRES_DB=consultoria_local
POSTGRES_USER=consultoria_local
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
# Prefer explicit migration jobs in staging/production. Local Compose may use true.
RUN_MIGRATIONS_ON_STARTUP=false

# O startup nunca cria dados demo. Mantenha false e use `npm run demo:seed`
# somente com APP_ENV=demo, banco isolado e confirmação explícita.
ENABLE_DEMO_SEED=false

# Cenário comercial sintético (apenas para o comando explícito demo:seed).
DEMO_SEED_CONFIRMATION=
DEMO_CLEANUP_CONFIRMATION=
DEMO_SEED_ADMIN_EMAIL=
DEMO_SEED_ADMIN_PASSWORD=
DEMO_SEED_OWNER_EMAIL=
DEMO_SEED_OWNER_PASSWORD=
DEMO_SEED_EMPLOYEE_EMAIL=
DEMO_SEED_EMPLOYEE_PASSWORD=
DEMO_SEED_EMPLOYEE_TWO_EMAIL=
DEMO_SEED_EMPLOYEE_TWO_PASSWORD=

# Required in production. Use a strong secret from the deploy secret manager.
JWT_SECRET=replace-with-a-strong-local-secret
JWT_EXPIRES_IN=7d
TRUST_PROXY_HOPS=0

# Required in production. Comma-separated list, no trailing slash.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
API_PUBLIC_URL=http://localhost:3000

# OpenAI. Required only when AI-backed question generation is enabled.
OPENAI_API_KEY=
AI_API_URL=https://api.openai.com/v1/responses
AI_MODEL=gpt-4o-mini
AI_QUESTION_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=20000

# Security rate limits. Values below are beta-friendly defaults.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
PASSWORD_FORGOT_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_FORGOT_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=12
PDF_RATE_LIMIT_WINDOW_MS=60000
PDF_RATE_LIMIT_MAX=10

# Password recovery and transactional email.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
APP_PUBLIC_URL=http://localhost:3000
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@localhost
EMAIL_TIMEOUT_MS=10000
EMAIL_ALLOW_TEST_PROVIDER=true

# Required only when EMAIL_PROVIDER=http. Never commit real values.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_API_AUTH_HEADER=Authorization
EMAIL_API_AUTH_SCHEME=Bearer
EMAIL_API_FROM_FIELD=from
EMAIL_API_TO_FIELD=to
EMAIL_API_SUBJECT_FIELD=subject
EMAIL_API_HTML_FIELD=html
EMAIL_API_TEXT_FIELD=text
EMAIL_API_MESSAGE_ID_FIELD=id

# Operations. Keep metrics behind ADMIN authentication.
ENABLE_INTERNAL_METRICS=false
REQUIRE_AI_IN_READINESS=false
LOG_FORMAT=json

# Optional external alert webhook. Keep disabled until an HTTPS receiver is approved.
ENABLE_EXTERNAL_ALERTS=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=3000
# Accepted compatibility aliases (prefer the canonical names above):
# EXTERNAL_ALERTS_ENABLED=false
# EXTERNAL_ALERTS_URL=

# Optional external backup adapter. "filesystem" is useful for a mounted external volume.
BACKUP_EXTERNAL_PROVIDER=none
BACKUP_EXTERNAL_DIRECTORY=

# Legal acceptance remains optional until drafts receive legal approval.
REQUIRE_LEGAL_ACCEPTANCE=false
TERMS_VERSION=beta-draft-v1
PRIVACY_VERSION=beta-draft-v1
