{
  "name": "consultoria-saas",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @consultoria/web run dev",
    "dev:api": "npm --workspace @consultoria/api run dev",
    "dev:all": "npm run dev:api && npm run dev:web",
    "staging:seed": "npm --workspace @consultoria/api run staging:seed",
    "staging:cleanup": "npm --workspace @consultoria/api run staging:cleanup",
    "build": "npm run build --workspace @consultoria/domain && npm run build --workspace @consultoria/api && npm run build --workspace @consultoria/web"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1"
  }
}
