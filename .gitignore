# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment variables
.env
.env.local
.env.*.local

# API Keys
**/api_keys.dart
**/secrets.dart

# SaaS development outputs (previously tracked artifacts remain tracked)
saas/**/node_modules/
saas/**/dist/
saas/**/*.tsbuildinfo
saas/test-results/
saas/playwright-report/
