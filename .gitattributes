# Normalize repository text files in the index.
* text=auto

# Keep source code and portable project files stable across Windows, Linux and CI.
.gitattributes text eol=lf
.gitignore text eol=lf
*.cc text eol=lf
*.cmake text eol=lf
*.css text eol=lf
*.dart text eol=lf
*.gradle text eol=lf
*.h text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsx text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.swift text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows-native command scripts remain CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be newline-normalized.
*.db binary
*.gif binary
*.gz binary
*.ico binary
*.jpeg binary
*.jpg binary
*.otf binary
*.pdf binary
*.png binary
*.sqlite binary
*.sqlite3 binary
*.tar binary
*.ttf binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
